# claude-bridge configuration. Copy to .env and fill in, or set these in the shell
# that launches the server. Never commit the real .env.

# REQUIRED. The shared secret device A must present as: Authorization: Bearer <token>
# Generate one with:  npm run token
BRIDGE_TOKEN=

# Where to listen. 0.0.0.0 is right when reaching this box over Tailscale or LAN.
# Use 127.0.0.1 if you are putting a tunnel in front of it.
BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=8790

# Working directory the delegated Claude Code runs in by default.
# The caller can override it per call with the cwd argument.
BRIDGE_CWD=C:\Users\HP 865 G10\Desktop\Claude WorkSpace

# Permission posture for delegated runs. `auto` matches this machine's own interactive
# default and lets the worker do real work. bypassPermissions is refused by the server:
# the caller is remote, and bypass would hand them unattended shell here.
BRIDGE_PERMISSION_MODE=auto

# Optional tool allowlist, comma separated, e.g. "Read,Grep,Glob,Edit,Bash".
# Leave empty for every tool the session normally has.
BRIDGE_ALLOWED_TOOLS=

# Optional model override for delegated runs. Empty uses this machine's default.
# The caller can override this per call with the `model` argument (fable, opus, sonnet).
BRIDGE_MODEL=

# Optional effort default for delegated runs (low, medium, high, xhigh, max).
# The caller can override this per call with the `effort` argument.
BRIDGE_EFFORT=

# Most delegated runs alive at once. Not a capability limit: it stops a runaway caller
# from spawning Claude processes until the machine falls over.
BRIDGE_MAX_CONCURRENT_JOBS=6

# Ceiling on one delegated run. Default 1 hour.
BRIDGE_JOB_TIMEOUT_MS=3600000

# Longest a single tool call will block before returning a job_id or a status.
# The limit that bites is the caller's IDLE clock (300s for HTTP servers), not its wall
# clock (about 27.8 hours by default). 240 stays under it with no config on the caller.
# Raise it only if device A sets a per-server "timeout" in its MCP config.
BRIDGE_MAX_WAIT_SECONDS=240

# How long finished jobs stay on disk. Default 7 days.
BRIDGE_JOB_RETENTION_MS=604800000
